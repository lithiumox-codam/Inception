FROM alpine:3.19

ARG WP_VERSION=latest
ENV WP_PATH=/var/www/html
ENV WP_SOURCE_DIR=/usr/src/wordpress

RUN apk update && \
    apk add --no-cache \
    bash \
    curl \
    tar \
    mysql-client \
    gettext \
    sudo \
    php82 \
    php82-fpm \
    php82-mysqli \
    php82-json \
    php82-curl \
    php82-gd \
    php82-intl \
    php82-mbstring \
    php82-opcache \
    php82-xml \
    php82-zip \
    php82-phar \
    php82-dom \
    php82-simplexml \
    php82-xmlwriter \
    php82-tokenizer \
    php82-fileinfo \
    php82-session \
    php82-ctype \
    php82-iconv \
    php82-bcmath \
    php82-exif && \
    rm -rf /var/cache/apk/*

RUN ln -s /usr/bin/php82 /usr/bin/php

# Changes to the default PHP-FPM configuration with sed so that it runs in the foreground and logs to stderr
RUN sed -i "s|;daemonize = yes|daemonize = no|g" /etc/php82/php-fpm.conf && \
    sed -i "s|error_log = /var/log/php82/error.log|error_log = /dev/stderr|g" /etc/php82/php-fpm.conf

COPY ./conf/www.conf /etc/php82/php-fpm.d/www.conf

RUN chown root:root /etc/php82/php-fpm.d/www.conf && \
    chmod 644 /etc/php82/php-fpm.d/www.conf

# Download and install WP-CLI
RUN curl -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && \
    chmod +x /usr/local/bin/wp

# Download WordPress core files and store them in the source directory within the image
RUN curl -o /tmp/wordpress.tar.gz -SL https://wordpress.org/wordpress-${WP_VERSION}.tar.gz && \
    tar -xzf /tmp/wordpress.tar.gz -C /tmp && \
    # Create the source directory
    mkdir -p ${WP_SOURCE_DIR} && \
    # Copy downloaded files into the source directory
    cp -rp /tmp/wordpress/. ${WP_SOURCE_DIR}/ && \
    # Set ownership of source files
    chown -R nobody:nobody ${WP_SOURCE_DIR} && \
    # Clean up temporary files
    rm /tmp/wordpress.tar.gz && \
    rm -rf /tmp/wordpress

# Create the web root directory (mount point) and set its ownership
# The entrypoint will populate this directory from WP_SOURCE_DIR if the volume is empty
RUN mkdir -p ${WP_PATH} && chown nobody:nobody ${WP_PATH}

# Copy entrypoint script and make it executable
COPY ./tools/init.sh /usr/local/bin/init.sh
RUN chmod +x /usr/local/bin/init.sh

# Sets the working directory to the web root directory
WORKDIR ${WP_PATH}

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/init.sh"]

CMD ["/usr/sbin/php-fpm82", "-F"]
