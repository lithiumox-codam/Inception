server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN_NAME};

    # Specify web root (points to the shared volume)
    root /var/www/html;

    # Default index file (needed for try_files)
    index index.php index.html index.htm;

    # --- SSL Configuration ---
    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Add strong ciphers, session cache, etc. for production
    # ssl_ciphers '...';
    # ssl_prefer_server_ciphers on;
    # ssl_session_cache shared:SSL:10m;
    # ssl_session_timeout 10m;
    # ssl_session_tickets off; # Consider security implications
    # ssl_stapling on; # Requires resolver directive
    # ssl_stapling_verify on; # Requires resolver directive
    # resolver 8.8.8.8 8.8.4.4 valid=300s; # Example resolver for stapling

    # --- Logging ---
    access_log /dev/stdout;
    error_log /dev/stderr warn; # Log warnings and errors

    # --- Security Headers ---
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # add_header X-Frame-Options "SAMEORIGIN" always;
    # add_header X-XSS-Protection "1; mode=block" always;
    # add_header X-Content-Type-Options "nosniff" always;
    # add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # add_header Content-Security-Policy "..." always; # Define your CSP

    # --- Location Block for Static Files ---
    location ~* \.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|avif)$ {
        try_files $uri =404;
        expires 1y; # Cache static assets aggressively in browser
        add_header Cache-Control "public, immutable";
        access_log off; # Don't log access for static files
    }

    # --- Location Block for ALL other requests (including PHP) ---
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # --- Location Block specifically for PHP files ---
    location ~ \.php$ {
        location ~* /wp-content/uploads/.*\.php$ {
            deny all;
        }
        include fastcgi_params;
        fastcgi_pass wordpress:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param Host $host;
        fastcgi_param X-Real-IP $remote_addr;
        fastcgi_param X-Forwarded-For $proxy_add_x_forwarded_for;
        fastcgi_param X-Forwarded-Proto $scheme;
        fastcgi_param HTTPS on;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_no_cache 1;
        fastcgi_cache_bypass 1;
    }

    # Deny access to hidden files like .htaccess, .git, etc.
    location ~ /\. {
        deny all;
    }

    # Deny access to potentially sensitive WordPress files
    location ~* /(?:readme\.html|license\.txt|wp-config-sample\.php|wp-config\.php|wp-admin/includes/|wp-content/plugins/debug\.log)$ {
        deny all;
    }
}